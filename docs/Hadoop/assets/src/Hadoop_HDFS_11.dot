digraph {
    graph [fontname="Microsoft YaHei"];
    node [fontname="Microsoft YaHei", shape="box", style="filled"];
    edge [fontname="Microsoft YaHei"];
    NN [label="NameNode\nfsimage + edits", fillcolor="#E3F2FD"];
    SNN [label="SecondaryNameNode\n定期合并", fillcolor="#E8F5E9"];
    NN -> SNN [label="拉取"];
    SNN -> NN [label="回传新 fsimage"];
}
