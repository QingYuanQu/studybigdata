# ============================================================
# 瘦身规则：把仓库从 1.5GB 压到约 86MB
# ============================================================

# ---------- 1. 构建产物 ----------
_site/
.cache/
__pycache__/
node_modules/

# ---------- 2. 编辑器 / 系统 ----------
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---------- 3. 数据集（819MB，GitHub 单文件硬限 100MB） ----------
**/数据/**
*.tsv
*.jsonl

# ---------- 4. Office 与压缩包（不属于网页内容） ----------
*.pptx
*.ppsx
*.docx
*.doc
*.xlsx
*.vsdx
*.zip
*.7z
*.rar
*.mp4
*.avi

# ---------- 5. 工具导出产物（含指向外部 assets 的断链 md） ----------
**/export/**
**/.export/**

# ---------- 6. 历史备份图库（有正式 img/ 目录，无需重复） ----------
img_bak/

# ---------- 7. 待处理杂物 ----------
_wait/

# ---------- 8. 已迁入 docs/ 的旧副本 ----------
# 这些目录因 Windows 文件占用 / git mv 中途中断，未能整体移动，
# 已用「逐文件复制 + 0 缺失校验」的方式迁入 docs/。
# 本地确认无误后可直接删掉下面这些目录；在此之前禁止它们被再次跟踪。
/Hadoop/
/img/
/DatabaseTheory/
/Hive大数据存储与处理/
/Java/
/Kafka/
/Kettle/
/Linux/
/MongoDB/
/MySQL/
/Python/
/Scala/
/Spark/
/Vision/
/ZooKeeper/

# ---------- 9. 脚本产物 ----------
*.bak
_link_report.txt
